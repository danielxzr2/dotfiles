# i3 config file (v4) — https://i3wm.org/docs/userguide.html

# ─── Variables ───────────────────────────────────────────
set $mod Mod4
set $term xfce4-terminal
set $lock i3lock --nofork --color=1e1e2e
set $refresh_i3status killall -SIGUSR1 i3status

# Catppuccin Mocha
set $base     #1e1e2e
set $mantle   #181825
set $surface0 #313244
set $surface1 #45475a
set $overlay0 #6c7086
set $text     #cdd6f4
set $subtext  #a6adc8
set $blue     #89b4fa
set $mauve    #cba6f7
set $red      #f38ba8
set $peach    #fab387

font pango:JetBrainsMono Nerd Font 10

# ─── Apariencia ──────────────────────────────────────────
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 6
gaps outer 2
smart_gaps on

# class                 border    bground   text      indicator child_border
client.focused          $blue     $base     $text     $mauve    $blue
client.focused_inactive $surface1 $base     $subtext  $surface1 $surface1
client.unfocused        $surface0 $mantle   $overlay0 $surface0 $surface0
client.urgent           $red      $base     $red      $red      $red
client.placeholder      $overlay0 $base     $text     $overlay0 $overlay0
client.background       $base

# ─── Autostart ───────────────────────────────────────────
exec --no-startup-id dex-autostart --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- $lock
exec --no-startup-id nm-applet
exec --no-startup-id dunst
exec --no-startup-id picom -b
exec --no-startup-id xset r rate 250 40          # repetición de teclas más rápida
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/.config/i3/wallpaper.jpg

# ─── Lanzadores ──────────────────────────────────────────
floating_modifier $mod
tiling_drag modifier titlebar

bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term -e "tmux new-session -A -s main"
bindsym $mod+d exec --no-startup-id rofi -show drun || dmenu_run
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Tab exec --no-startup-id rofi -show window
bindsym $mod+Shift+q kill

# Bloquear pantalla / screenshots
bindsym $mod+Escape exec --no-startup-id loginctl lock-session
bindsym Print exec --no-startup-id flameshot gui
bindsym Shift+Print exec --no-startup-id flameshot full --clipboard

# ─── Teclas multimedia ───────────────────────────────────
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# ─── Foco y movimiento (hjkl, igual que nvim/tmux) ───────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ─── Layout ──────────────────────────────────────────────
bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Scratchpad (terminal/notas flotantes)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Volver al workspace anterior pulsando el mismo número
workspace_auto_back_and_forth yes

# ─── Workspaces ──────────────────────────────────────────
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Asignar apps a workspaces (descomenta/ajusta según uses)
# assign [class="firefox"] $ws2
# assign [class="Slack|discord"] $ws9
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable
for_window [class="Pavucontrol|Nm-connection-editor|Blueman-manager"] floating enable

# ─── Sesión ──────────────────────────────────────────────
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

set $mode_system (l)ock  (e)xit  (s)uspend  (r)eboot  (p)oweroff
mode "$mode_system" {
        bindsym l exec --no-startup-id loginctl lock-session, mode "default"
        bindsym e exec --no-startup-id i3-msg exit, mode "default"
        bindsym s exec --no-startup-id systemctl suspend, mode "default"
        bindsym r exec --no-startup-id systemctl reboot, mode "default"
        bindsym p exec --no-startup-id systemctl poweroff, mode "default"
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $mod+Shift+e mode "$mode_system"

# ─── Resize ──────────────────────────────────────────────
mode "resize" {
        bindsym h resize shrink width 10 px or 5 ppt
        bindsym j resize grow height 10 px or 5 ppt
        bindsym k resize shrink height 10 px or 5 ppt
        bindsym l resize grow width 10 px or 5 ppt
        bindsym Left resize shrink width 10 px or 5 ppt
        bindsym Down resize grow height 10 px or 5 ppt
        bindsym Up resize shrink height 10 px or 5 ppt
        bindsym Right resize grow width 10 px or 5 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ─── Barra ───────────────────────────────────────────────
bar {
        position top
        status_command i3status -c ~/.config/i3status/config
        tray_output primary
        colors {
                background $mantle
                statusline $text
                separator  $surface1

                #                  border    bground   text
                focused_workspace  $blue     $blue     $base
                active_workspace   $surface1 $surface1 $text
                inactive_workspace $mantle   $mantle   $subtext
                urgent_workspace   $red      $red      $base
                binding_mode       $peach    $peach    $base
        }
}
